# Minimal bring-up config fragment for Xiaomi Pad 7 Pro (muyu)
CONFIG_LOCALVERSION="-muyu-mainline"

# Pstore / Ramoops for crash & boot log recovery
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Simple Framebuffer + Console + Tux Logo
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
CONFIG_DRM_SIMPLEDRM=y

# Initramfs & Earlycon
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_SERIAL_EARLYCON=y

# USB Gadget for early network/shell
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y

# Avoid macOS case-insensitive FS collision in netfilter during early bring-up
# CONFIG_NETFILTER is not set
