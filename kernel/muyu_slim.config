# Pstore / Ramoops
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Framebuffer + Console + Tux Logo
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
CONFIG_DRM=y
CONFIG_DRM_AUX_HPD_BRIDGE=y
# CONFIG_DRM_SIMPLEDRM is not set

# Initramfs (XZ compressed) & Forced Cmdline
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/work/out/initramfs_root"
CONFIG_INITRAMFS_COMPRESSION_XZ=y
CONFIG_RD_GZIP=y
CONFIG_SERIAL_EARLYCON=y
# CONFIG_BOOT_CONFIG is not set
CONFIG_CMDLINE="console=tty0 fbcon=font:TER16x32 loglevel=7 ignore_loglevel panic=20 clk_ignore_unused pd_ignore_unused initramfs_async=0 rw"
CONFIG_CMDLINE_FORCE=y
CONFIG_PANIC_TIMEOUT=20

# Core SoC, Clocks, Pinctrl, Interconnect, LLCC, UFS, VADC, RTC, SPI, RNG, QFPROM, USB Gadget
# CONFIG_QCOM_OCMEM is not set
