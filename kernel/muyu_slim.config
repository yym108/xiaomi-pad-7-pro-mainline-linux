# Test O: ADSP/CDSP Remoteproc + GLINK + PD Mapper + PMIC GLINK + Battery + UCSI + FastRPC
CONFIG_REMOTEPROC=y
CONFIG_REMOTEPROC_CDEV=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_PDR_MSG=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_BATTERY_QCOM_BATTMGR=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_QCOM_FASTRPC=y

# Test P: Adreno 735 (gen71100) GPU 3D Hardware Acceleration
CONFIG_DRM_EXEC=y
CONFIG_DRM_GPUVM=y
CONFIG_DRM_SCHED=y
CONFIG_DRM_MSM=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

# Test Q: Display Subsystem (MDSS DPU + Dual-DSI + 4nm PHY + NT36532 + KTZ8866)
# CONFIG_DRM_MSM_MDP4 is not set
# CONFIG_DRM_MSM_MDP5 is not set
# CONFIG_DRM_MSM_HDMI is not set
# CONFIG_DRM_MSM_DSI_28NM_PHY is not set
# CONFIG_DRM_MSM_DSI_20NM_PHY is not set
# CONFIG_DRM_MSM_DSI_28NM_8960_PHY is not set
# CONFIG_DRM_MSM_DSI_14NM_PHY is not set
# CONFIG_DRM_MSM_DSI_10NM_PHY is not set
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_PANEL_NOVATEK_NT36532=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_KTZ8866=y

# Test R: Novatek NT36532 SPI Touchscreen
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_NOVATEK_NT36532_SPI=y

# Test S: Hall Sensors + USB-C DP AltMode (QMP Combo PHY + WCD939x-USBSS + MDSS DP0) + Quad AW88261 SmartPA + AudioReach
CONFIG_KEYBOARD_GPIO=y
CONFIG_TYPEC_DP_ALTMODE=y
CONFIG_TYPEC_MUX_WCD939X_USBSS=y
CONFIG_DRM_MSM_DP=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_AW88261=y
CONFIG_PINCTRL_LPASS_LPI=y
CONFIG_PINCTRL_SM8650_LPASS_LPI=y
CONFIG_QCOM_APR=y
CONFIG_SOUNDWIRE=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SND_SOC_SC8280XP=y

# Phase 3: Full Linux Distro RootFS (SquashFS ZSTD + OverlayFS + uinput/uhid)
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_INPUT_UINPUT=y
CONFIG_UHID=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_QCOMTEE=y
CONFIG_DYNAMIC_DEBUG=y

# Networking: Policy Routing + Netfilter / nftables / iptables (for Clash TUN auto-route, VPN, Firewall, Docker)
