From bebad57f559d1fe2818051fffe0d12f5254c4d47 Mon Sep 17 00:00:00 2001
From: yym108 <183073514+yym108@users.noreply.github.com>
Date: Mon, 23 Nov 2026 18:29:45 +0800
Subject: [PATCH] media: qcom: camss/camcc/dts: enable SM8635 rear 50MP S5KJN1
 camera on Xiaomi Pad 7 Pro

---
 .../boot/dts/qcom/sm8635-xiaomi-muyu.dts      | 411 ++++++++++++++++++
 drivers/clk/qcom/camcc-sm8650.c               |  75 +++-
 drivers/clk/qcom/gcc-sm8635.c                 |  32 ++
 drivers/media/platform/qcom/camss/camss.c     |  15 +
 drivers/pinctrl/qcom/pinctrl-sm8635.c         |  42 +-
 5 files changed, 567 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts b/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts
index 98a4d0495..16287e9f5 100644
--- a/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts
@@ -11,6 +11,7 @@
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/clock/qcom,dsi-phy-28nm.h>
 #include <dt-bindings/clock/qcom,rpmh.h>
+#include <dt-bindings/clock/qcom,sm8650-camcc.h>
 #include <dt-bindings/clock/qcom,sm8650-dispcc.h>
 #include <dt-bindings/clock/qcom,sm8650-gcc.h>
 #include <dt-bindings/clock/qcom,sm8650-gpucc.h>
@@ -1311,6 +1312,15 @@ vreg_l23b_1p8: ldo23 {
 					regulator-max-microvolt = <1800000>;
 					regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 				};
+
+				vreg_bob1: bob {
+					regulator-name = "vreg_bob1";
+					regulator-min-microvolt = <3288000>;
+					regulator-max-microvolt = <3320000>;
+					regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
+					regulator-boot-on;
+					regulator-always-on;
+				};
 			};
 
 			regulators-1 {
@@ -1376,6 +1386,66 @@ vreg_l4e_1p8: ldo4 {
 					regulator-always-on;
 				};
 			};
+
+			regulators-4 {
+				compatible = "qcom,pm8010-rpmh-regulators";
+				qcom,pmic-id = "n";
+
+				vdd-l1-l2-supply = <&vreg_s2b_1p25>;
+				vdd-l3-l4-supply = <&vreg_bob1>;
+				vdd-l5-supply = <&vreg_s1b_1p85>;
+				vdd-l6-supply = <&vreg_bob1>;
+				vdd-l7-supply = <&vreg_bob1>;
+
+				vreg_l1n_1p05: ldo1 {
+					regulator-name = "vreg_l1n_1p05";
+					regulator-min-microvolt = <1048000>;
+					regulator-max-microvolt = <1056000>;
+					regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+				};
+
+				vreg_l2n_1p2: ldo2 {
+					regulator-name = "vreg_l2n_1p2";
+					regulator-min-microvolt = <1200000>;
+					regulator-max-microvolt = <1200000>;
+					regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+				};
+
+				vreg_l3n_2p8: ldo3 {
+					regulator-name = "vreg_l3n_2p8";
+					regulator-min-microvolt = <2800000>;
+					regulator-max-microvolt = <2800000>;
+					regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+				};
+
+				vreg_l4n_1p8: ldo4 {
+					regulator-name = "vreg_l4n_1p8";
+					regulator-min-microvolt = <1800000>;
+					regulator-max-microvolt = <1800000>;
+					regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+				};
+
+				vreg_l5n_1p8: ldo5 {
+					regulator-name = "vreg_l5n_1p8";
+					regulator-min-microvolt = <1800000>;
+					regulator-max-microvolt = <1800000>;
+					regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+				};
+
+				vreg_l6n_2p8: ldo6 {
+					regulator-name = "vreg_l6n_2p8";
+					regulator-min-microvolt = <2800000>;
+					regulator-max-microvolt = <2800000>;
+					regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+				};
+
+				vreg_l7n_2p8: ldo7 {
+					regulator-name = "vreg_l7n_2p8";
+					regulator-min-microvolt = <2800000>;
+					regulator-max-microvolt = <2800000>;
+					regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+				};
+			};
 		};
 
 		cpufreq_hw: cpufreq@17d91000 {
@@ -1543,6 +1613,255 @@ videocc: clock-controller@aaf0000 {
 			#power-domain-cells = <1>;
 		};
 
+		camcc: clock-controller@ade0000 {
+			compatible = "qcom,sm8635-camcc";
+			reg = <0x0 0x0ade0000 0x0 0x20000>;
+			clocks = <&gcc GCC_CAMERA_AHB_CLK>,
+				 <&bi_tcxo_div2>,
+				 <&bi_tcxo_ao_div2>,
+				 <&sleep_clk>;
+			power-domains = <&rpmhpd RPMHPD_MMCX>,
+					<&rpmhpd RPMHPD_MXC>;
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+			#power-domain-cells = <1>;
+		};
+
+		cci0: cci@ac15000 {
+			compatible = "qcom,sm8650-cci", "qcom,msm8996-cci";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <0x0 0x0ac15000 0x0 0x1000>;
+			interrupts = <GIC_SPI 426 IRQ_TYPE_EDGE_RISING>;
+			power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
+			clocks = <&camcc CAM_CC_CAMNOC_AXI_NRT_CLK>,
+				 <&camcc CAM_CC_CPAS_AHB_CLK>,
+				 <&camcc CAM_CC_CCI_0_CLK>;
+			clock-names = "camnoc_axi",
+				      "cpas_ahb",
+				      "cci";
+			assigned-clocks = <&camcc CAM_CC_CCI_0_CLK>;
+			assigned-clock-rates = <37500000>;
+			pinctrl-0 = <&cci0_0_default &cci0_1_default>;
+			pinctrl-1 = <&cci0_0_sleep &cci0_1_sleep>;
+			pinctrl-names = "default", "sleep";
+			status = "okay";
+
+			cci0_i2c0: i2c-bus@0 {
+				reg = <0>;
+				clock-frequency = <400000>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+			};
+
+			cci0_i2c1: i2c-bus@1 {
+				reg = <1>;
+				clock-frequency = <400000>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				camera@10 {
+					compatible = "samsung,s5kjn1";
+					reg = <0x10>;
+
+					clocks = <&camcc CAM_CC_MCLK0_CLK>;
+					assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
+					assigned-clock-rates = <24000000>;
+
+					pinctrl-names = "default", "sleep";
+					pinctrl-0 = <&cam_mclk0_default &cam_wide_rst_default>;
+					pinctrl-1 = <&cam_mclk0_sleep &cam_wide_rst_sleep>;
+
+					reset-gpios = <&tlmm 14 GPIO_ACTIVE_LOW>;
+
+					vddd-supply = <&vreg_l1n_1p05>;
+					vdda-supply = <&vreg_l3n_2p8>;
+					vddio-supply = <&vreg_l4n_1p8>;
+					afvdd-supply = <&vreg_l7n_2p8>;
+
+					orientation = <1>;
+					rotation = <90>;
+
+					port {
+						s5kjn1_ep: endpoint {
+							data-lanes = <0 1 2 3>;
+							link-frequencies = /bits/ 64 <700000000>;
+							remote-endpoint = <&csiphy1_ep>;
+						};
+					};
+				};
+			};
+		};
+
+		camss: isp@acb6000 {
+			compatible = "qcom,sm8635-camss";
+			reg = <0x0 0x0acb6000 0x0 0x1000>,
+			      <0x0 0x0acb8000 0x0 0x1000>,
+			      <0x0 0x0acba000 0x0 0x1000>,
+			      <0x0 0x0acbc000 0x0 0x1000>,
+			      <0x0 0x0accb000 0x0 0x1000>,
+			      <0x0 0x0acd0000 0x0 0x1000>,
+			      <0x0 0x0ace4000 0x0 0x2000>,
+			      <0x0 0x0ace6000 0x0 0x2000>,
+			      <0x0 0x0ace8000 0x0 0x2000>,
+			      <0x0 0x0acea000 0x0 0x2000>,
+			      <0x0 0x0acec000 0x0 0x2000>,
+			      <0x0 0x0ac62000 0x0 0xf000>,
+			      <0x0 0x0ac71000 0x0 0xf000>,
+			      <0x0 0x0ac80000 0x0 0xf000>,
+			      <0x0 0x0accc000 0x0 0x2000>,
+			      <0x0 0x0acd1000 0x0 0x2000>;
+			reg-names = "csid_wrapper",
+				    "csid0",
+				    "csid1",
+				    "csid2",
+				    "csid_lite0",
+				    "csid_lite1",
+				    "csiphy0",
+				    "csiphy1",
+				    "csiphy2",
+				    "csiphy3",
+				    "csiphy4",
+				    "vfe0",
+				    "vfe1",
+				    "vfe2",
+				    "vfe_lite0",
+				    "vfe_lite1";
+
+			clocks = <&camcc CAM_CC_CAMNOC_AXI_RT_CLK>,
+				 <&camcc CAM_CC_CPAS_AHB_CLK>,
+				 <&camcc CAM_CC_CPAS_FAST_AHB_CLK>,
+				 <&camcc CAM_CC_CPAS_IFE_0_CLK>,
+				 <&camcc CAM_CC_CPAS_IFE_1_CLK>,
+				 <&camcc CAM_CC_CPAS_IFE_2_CLK>,
+				 <&camcc CAM_CC_CPAS_IFE_LITE_CLK>,
+				 <&camcc CAM_CC_CSID_CLK>,
+				 <&camcc CAM_CC_CSIPHY0_CLK>,
+				 <&camcc CAM_CC_CSI0PHYTIMER_CLK>,
+				 <&camcc CAM_CC_CSIPHY1_CLK>,
+				 <&camcc CAM_CC_CSI1PHYTIMER_CLK>,
+				 <&camcc CAM_CC_CSIPHY2_CLK>,
+				 <&camcc CAM_CC_CSI2PHYTIMER_CLK>,
+				 <&camcc CAM_CC_CSIPHY3_CLK>,
+				 <&camcc CAM_CC_CSI3PHYTIMER_CLK>,
+				 <&camcc CAM_CC_CSIPHY4_CLK>,
+				 <&camcc CAM_CC_CSI4PHYTIMER_CLK>,
+				 <&camcc CAM_CC_CSID_CSIPHY_RX_CLK>,
+				 <&gcc GCC_CAMERA_HF_AXI_CLK>,
+				 <&camcc CAM_CC_QDSS_DEBUG_XO_CLK>,
+				 <&camcc CAM_CC_IFE_0_CLK>,
+				 <&camcc CAM_CC_IFE_0_FAST_AHB_CLK>,
+				 <&camcc CAM_CC_IFE_1_CLK>,
+				 <&camcc CAM_CC_IFE_1_FAST_AHB_CLK>,
+				 <&camcc CAM_CC_IFE_2_CLK>,
+				 <&camcc CAM_CC_IFE_2_FAST_AHB_CLK>,
+				 <&camcc CAM_CC_IFE_LITE_CLK>,
+				 <&camcc CAM_CC_IFE_LITE_AHB_CLK>,
+				 <&camcc CAM_CC_IFE_LITE_CPHY_RX_CLK>,
+				 <&camcc CAM_CC_IFE_LITE_CSID_CLK>;
+			clock-names = "camnoc_axi",
+				      "cpas_ahb",
+				      "cpas_fast_ahb",
+				      "cpas_vfe0",
+				      "cpas_vfe1",
+				      "cpas_vfe2",
+				      "cpas_vfe_lite",
+				      "csid",
+				      "csiphy0",
+				      "csiphy0_timer",
+				      "csiphy1",
+				      "csiphy1_timer",
+				      "csiphy2",
+				      "csiphy2_timer",
+				      "csiphy3",
+				      "csiphy3_timer",
+				      "csiphy4",
+				      "csiphy4_timer",
+				      "csiphy_rx",
+				      "gcc_axi_hf",
+				      "qdss_debug_xo",
+				      "vfe0",
+				      "vfe0_fast_ahb",
+				      "vfe1",
+				      "vfe1_fast_ahb",
+				      "vfe2",
+				      "vfe2_fast_ahb",
+				      "vfe_lite",
+				      "vfe_lite_ahb",
+				      "vfe_lite_cphy_rx",
+				      "vfe_lite_csid";
+
+			interrupts = <GIC_SPI 601 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 603 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 431 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 605 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 376 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 477 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 478 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 479 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 448 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 122 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 602 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 604 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 688 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 606 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 377 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "csid0",
+					  "csid1",
+					  "csid2",
+					  "csid_lite0",
+					  "csid_lite1",
+					  "csiphy0",
+					  "csiphy1",
+					  "csiphy2",
+					  "csiphy3",
+					  "csiphy4",
+					  "vfe0",
+					  "vfe1",
+					  "vfe2",
+					  "vfe_lite0",
+					  "vfe_lite1";
+
+			interconnects = <&gem_noc SM8635_GEM_NOC_CHM_APPS QCOM_ICC_TAG_ACTIVE_ONLY
+					 &config_noc SM8635_CONFIG_NOC_QHS_CAMERA_CFG QCOM_ICC_TAG_ACTIVE_ONLY>,
+					<&mmss_noc SM8635_MMSS_NOC_QNM_CAMNOC_HF QCOM_ICC_TAG_ALWAYS
+					 &mc_virt SM8635_MC_VIRT_EBI QCOM_ICC_TAG_ALWAYS>;
+			interconnect-names = "ahb",
+					     "hf_mnoc";
+
+			iommus = <&apps_smmu 0x800 0x20>;
+
+			power-domains = <&camcc CAM_CC_IFE_0_GDSC>,
+					<&camcc CAM_CC_IFE_1_GDSC>,
+					<&camcc CAM_CC_IFE_2_GDSC>,
+					<&camcc CAM_CC_TITAN_TOP_GDSC>;
+			power-domain-names = "ife0", "ife1", "ife2", "top";
+
+			vdd-csiphy01-0p9-supply = <&vreg_l1d_0p88>;
+			vdd-csiphy01-1p2-supply = <&vreg_l3d_1p2>;
+			vdd-csiphy24-0p9-supply = <&vreg_l1d_0p88>;
+			vdd-csiphy24-1p2-supply = <&vreg_l3d_1p2>;
+			vdd-csiphy35-0p9-supply = <&vreg_l1d_0p88>;
+			vdd-csiphy35-1p2-supply = <&vreg_l3d_1p2>;
+
+			status = "okay";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@1 {
+					reg = <1>;
+
+					csiphy1_ep: endpoint {
+						clock-lanes = <7>;
+						data-lanes = <0 1 2 3>;
+						remote-endpoint = <&s5kjn1_ep>;
+					};
+				};
+			};
+		};
+
 		gpucc: clock-controller@3d90000 {
 			compatible = "qcom,sm8635-gpucc";
 			reg = <0x0 0x03d90000 0x0 0xa000>;
@@ -1688,6 +2007,98 @@ qup_i2c3_default: qup-i2c3-default-state {
 				bias-disable;
 			};
 
+			cci0_0_default: cci0-0-default-state {
+				sda-pins {
+					pins = "gpio70";
+					function = "cci_i2c_sda0";
+					drive-strength = <2>;
+					bias-pull-up;
+				};
+
+				scl-pins {
+					pins = "gpio71";
+					function = "cci_i2c_scl0";
+					drive-strength = <2>;
+					bias-pull-up;
+				};
+			};
+
+			cci0_0_sleep: cci0-0-sleep-state {
+				sda-pins {
+					pins = "gpio70";
+					function = "cci_i2c_sda0";
+					drive-strength = <2>;
+					bias-pull-down;
+				};
+
+				scl-pins {
+					pins = "gpio71";
+					function = "cci_i2c_scl0";
+					drive-strength = <2>;
+					bias-pull-down;
+				};
+			};
+
+			cci0_1_default: cci0-1-default-state {
+				sda-pins {
+					pins = "gpio72";
+					function = "cci_i2c_sda1";
+					drive-strength = <4>;
+					bias-disable;
+				};
+
+				scl-pins {
+					pins = "gpio73";
+					function = "cci_i2c_scl1";
+					drive-strength = <4>;
+					bias-disable;
+				};
+			};
+
+			cci0_1_sleep: cci0-1-sleep-state {
+				sda-pins {
+					pins = "gpio72";
+					function = "cci_i2c_sda1";
+					drive-strength = <2>;
+					bias-pull-down;
+				};
+
+				scl-pins {
+					pins = "gpio73";
+					function = "cci_i2c_scl1";
+					drive-strength = <2>;
+					bias-pull-down;
+				};
+			};
+
+			cam_mclk0_default: cam-mclk0-default-state {
+				pins = "gpio64";
+				function = "cam_mclk";
+				drive-strength = <4>;
+				bias-disable;
+			};
+
+			cam_mclk0_sleep: cam-mclk0-sleep-state {
+				pins = "gpio64";
+				function = "cam_mclk";
+				drive-strength = <2>;
+				bias-pull-down;
+			};
+
+			cam_wide_rst_default: cam-wide-rst-default-state {
+				pins = "gpio14";
+				function = "gpio";
+				drive-strength = <2>;
+				bias-disable;
+			};
+
+			cam_wide_rst_sleep: cam-wide-rst-sleep-state {
+				pins = "gpio14";
+				function = "gpio";
+				drive-strength = <2>;
+				bias-pull-down;
+			};
+
 			nanosic_mcu_default: nanosic-mcu-default-state {
 				sleep-pins {
 					pins = "gpio98";
diff --git a/drivers/clk/qcom/camcc-sm8650.c b/drivers/clk/qcom/camcc-sm8650.c
index 3aad816ed..fd8cbbb59 100644
--- a/drivers/clk/qcom/camcc-sm8650.c
+++ b/drivers/clk/qcom/camcc-sm8650.c
@@ -3532,6 +3532,19 @@ static struct clk_alpha_pll *cam_cc_sm8650_plls[] = {
 	&cam_cc_pll10,
 };
 
+static struct clk_alpha_pll *cam_cc_sm8635_plls[] = {
+	&cam_cc_pll0,
+	&cam_cc_pll1,
+	&cam_cc_pll2,
+	&cam_cc_pll3,
+	&cam_cc_pll4,
+	&cam_cc_pll5,
+	&cam_cc_pll6,
+	&cam_cc_pll7,
+	&cam_cc_pll8,
+	&cam_cc_pll9,
+};
+
 static const u32 cam_cc_sm8650_critical_cbcrs[] = {
 	0x132ec, /* CAM_CC_GDSC_CLK */
 	0x13308, /* CAM_CC_SLEEP_CLK */
@@ -3554,6 +3567,24 @@ static const struct qcom_cc_driver_data cam_cc_sm8650_driver_data = {
 	.num_clk_cbcrs = ARRAY_SIZE(cam_cc_sm8650_critical_cbcrs),
 };
 
+static const struct qcom_cc_driver_data cam_cc_sm8635_driver_data = {
+	.alpha_plls = cam_cc_sm8635_plls,
+	.num_alpha_plls = ARRAY_SIZE(cam_cc_sm8635_plls),
+	.clk_cbcrs = cam_cc_sm8650_critical_cbcrs,
+	.num_clk_cbcrs = ARRAY_SIZE(cam_cc_sm8650_critical_cbcrs),
+};
+
+static struct gdsc *cam_cc_sm8635_gdscs[] = {
+	[CAM_CC_TITAN_TOP_GDSC] = &cam_cc_titan_top_gdsc,
+	[CAM_CC_BPS_GDSC] = &cam_cc_bps_gdsc,
+	[CAM_CC_IFE_0_GDSC] = &cam_cc_ife_0_gdsc,
+	[CAM_CC_IFE_1_GDSC] = &cam_cc_ife_1_gdsc,
+	[CAM_CC_IFE_2_GDSC] = &cam_cc_ife_2_gdsc,
+	[CAM_CC_IPE_0_GDSC] = &cam_cc_ipe_0_gdsc,
+	[CAM_CC_SFE_0_GDSC] = &cam_cc_sfe_0_gdsc,
+	[CAM_CC_SFE_1_GDSC] = &cam_cc_sfe_1_gdsc,
+};
+
 static const struct qcom_cc_desc cam_cc_sm8650_desc = {
 	.config = &cam_cc_sm8650_regmap_config,
 	.clks = cam_cc_sm8650_clocks,
@@ -3566,15 +3597,55 @@ static const struct qcom_cc_desc cam_cc_sm8650_desc = {
 	.driver_data = &cam_cc_sm8650_driver_data,
 };
 
+static const struct qcom_cc_desc cam_cc_sm8635_desc = {
+	.config = &cam_cc_sm8650_regmap_config,
+	.clks = cam_cc_sm8650_clocks,
+	.num_clks = ARRAY_SIZE(cam_cc_sm8650_clocks),
+	.resets = cam_cc_sm8650_resets,
+	.num_resets = ARRAY_SIZE(cam_cc_sm8650_resets),
+	.gdscs = cam_cc_sm8635_gdscs,
+	.num_gdscs = ARRAY_SIZE(cam_cc_sm8635_gdscs),
+	.use_rpm = true,
+	.driver_data = &cam_cc_sm8635_driver_data,
