From 40ffca80ef68cdfd6a722445f04ad1df97685f8b Mon Sep 17 00:00:00 2001
From: yym <183073514+yym108@users.noreply.github.com>
Date: Sat, 21 Nov 2026 19:46:08 +0800
Subject: [PATCH 17/28] HID: add Nanosic WN8030 magnetic keyboard & touchpad
 support for Xiaomi Pad 7 Pro

1. Add hid-nanosic-wn8030 driver (adapted from map220v/sm8550-mainline for
   Linux 7.4-rc3) with deferred initialization so I2C/firmware loading never
   blocks early display/USB bring-up, plus flash/bootrom auto-detection.
2. Enable pmxr2230 ldo22 (3.3V) and ldo23 (1.8V), pinctrl (gpio98/116/127/128),
   and nanosic_mcu@4c on i2c3 (a8c000) in sm8635-xiaomi-muyu.dts.
3. Hardware-verified on Xiaomi Pad 7 Pro with stock MCU_Upgrade.bin (82716 B)
   loaded into WN8030 SRAM: both Xiaomi Keyboard (15D9:00A3) and Xiaomi
   Touchpad (15D9:00A1, hid-multitouch) work out of the box in Weston 13.
---
 .../boot/dts/qcom/sm8635-xiaomi-muyu.dts      |   55 +
 drivers/hid/Kconfig                           |    8 +
 drivers/hid/Makefile                          |    1 +
 drivers/hid/hid-nanosic-wn8030.c              | 1119 +++++++++++++++++
 4 files changed, 1183 insertions(+)
 create mode 100644 drivers/hid/hid-nanosic-wn8030.c

diff --git a/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts b/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts
index f4f8c196e..43ce6ef5b 100644
--- a/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts
@@ -1284,6 +1284,20 @@ vreg_l17b_3p0: ldo17 {
 					regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 					regulator-boot-on;
 				};
+
+				vreg_l22b_3p3: ldo22 {
+					regulator-name = "vreg_l22b_3p3";
+					regulator-min-microvolt = <3296000>;
+					regulator-max-microvolt = <3304000>;
+					regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+				};
+
+				vreg_l23b_1p8: ldo23 {
+					regulator-name = "vreg_l23b_1p8";
+					regulator-min-microvolt = <1800000>;
+					regulator-max-microvolt = <1800000>;
+					regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+				};
 			};
 
 			regulators-1 {
@@ -1661,6 +1675,29 @@ qup_i2c3_default: qup-i2c3-default-state {
 				bias-disable;
 			};
 
+			nanosic_mcu_default: nanosic-mcu-default-state {
+				sleep-pins {
+					pins = "gpio98";
+					function = "gpio";
+					drive-strength = <2>;
+					bias-pull-down;
+				};
+
+				reset-status-pins {
+					pins = "gpio127", "gpio128";
+					function = "gpio";
+					drive-strength = <2>;
+					bias-disable;
+				};
+
+				irq-pins {
+					pins = "gpio116";
+					function = "gpio";
+					drive-strength = <2>;
+					bias-disable;
+				};
+			};
+
 			qup_i2c11_default: qup-i2c11-default-state {
 				pins = "gpio44", "gpio45";
 				function = "qup1_se3";
@@ -2217,6 +2254,24 @@ i2c3: i2c@a8c000 {
 				clock-frequency = <400000>;
 				#address-cells = <1>;
 				#size-cells = <0>;
+
+				nanosic_mcu@4c {
+					compatible = "nanosic,wn8030-muyu", "nanosic,803";
+					reg = <0x4c>;
+
+					pinctrl-names = "default";
+					pinctrl-0 = <&nanosic_mcu_default>;
+
+					interrupt-parent = <&tlmm>;
+					interrupts = <116 IRQ_TYPE_EDGE_RISING>;
+
+					reset-gpios = <&tlmm 127 GPIO_ACTIVE_LOW>;
+					sleep-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;
+					status-gpios = <&tlmm 128 GPIO_ACTIVE_HIGH>;
+
+					vddio-supply = <&vreg_l23b_1p8>;
+					dvdd-supply = <&vreg_l22b_3p3>;
+				};
 			};
 
 			spi4: spi@a90000 {
