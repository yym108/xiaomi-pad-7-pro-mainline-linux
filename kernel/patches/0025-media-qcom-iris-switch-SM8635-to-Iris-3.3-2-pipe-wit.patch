From 2893481518ae8b7f945a10898addffc0e6ff3445 Mon Sep 17 00:00:00 2001
From: yym <183073514+yym108@users.noreply.github.com>
Date: Sun, 22 Nov 2026 17:34:54 +0800
Subject: [PATCH 25/28] media: qcom: iris: switch SM8635 to Iris 3.3 2-pipe
 with cliffs QoS register presets

---
 .../platform/qcom/iris/iris_platform_vpu3x.c  | 16 +++++++-------
 drivers/media/platform/qcom/iris/iris_vpu3x.c | 21 +++++++++++++++++++
 .../platform/qcom/iris/iris_vpu_common.h      |  1 +
 3 files changed, 31 insertions(+), 7 deletions(-)

diff --git a/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c b/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c
index 2596849b4..9fc37dec8 100644
--- a/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c
+++ b/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c
@@ -156,16 +156,18 @@ const struct iris_platform_data sm8550_data = {
 };
 
 /*
- * SM8635 (cliffs) uses VPU 3.0 with 2 VPP pipes (vpu30_2v.mbn), so it must use
- * VPU3.0 power-off ops (iris_vpu3_ops) instead of SM8650 VPU3.3 MVP NoC ops.
+ * SM8635 (cliffs) uses Iris33 2-pipe VPU (vpu30_2v.mbn) with SM8650-style
+ * clk/controller resets, VPU3.3 buffer sizing, and cliffs QoS preset registers.
  */
 const struct iris_platform_data sm8635_data = {
-	.firmware_desc_gen2 = &iris_vpu30_p4_gen2_desc,
-	.vpu_ops = &iris_vpu3_ops,
+	.firmware_desc_gen2 = &iris_vpu33_p4_gen2_desc,
+	.vpu_ops = &iris_vpu33_sm8635_ops,
 	.icc_tbl = iris_icc_info_vpu3x,
 	.icc_tbl_size = ARRAY_SIZE(iris_icc_info_vpu3x),
-	.clk_rst_tbl = sm8550_clk_reset_table,
-	.clk_rst_tbl_size = ARRAY_SIZE(sm8550_clk_reset_table),
+	.clk_rst_tbl = sm8650_clk_reset_table,
+	.clk_rst_tbl_size = ARRAY_SIZE(sm8650_clk_reset_table),
+	.controller_rst_tbl = sm8650_controller_reset_table,
+	.controller_rst_tbl_size = ARRAY_SIZE(sm8650_controller_reset_table),
 	.bw_tbl_dec = iris_bw_table_dec_vpu3x,
 	.bw_tbl_dec_size = ARRAY_SIZE(iris_bw_table_dec_vpu3x),
 	.pmdomain_tbl = iris_pmdomain_table_vpu3x,
@@ -179,7 +181,7 @@ const struct iris_platform_data sm8635_data = {
 	.dma_mask = 0xe0000000 - 1,
 	.inst_iris_fmts = iris_fmts_vpu3x_dec,
 	.inst_iris_fmts_size = ARRAY_SIZE(iris_fmts_vpu3x_dec),
-	.inst_caps = &platform_inst_cap_sm8550,
+	.inst_caps = &platform_inst_cap_qcs8300,
 	.slice_caps = &iris_vpu2_vpu3x_slice_caps,
 	.tz_cp_config_data = tz_cp_config_vpu3,
 	.tz_cp_config_data_size = ARRAY_SIZE(tz_cp_config_vpu3),
diff --git a/drivers/media/platform/qcom/iris/iris_vpu3x.c b/drivers/media/platform/qcom/iris/iris_vpu3x.c
index c3b760730..fa6aa8f8d 100644
--- a/drivers/media/platform/qcom/iris/iris_vpu3x.c
+++ b/drivers/media/platform/qcom/iris/iris_vpu3x.c
@@ -276,6 +276,27 @@ const struct vpu_ops iris_vpu33_ops = {
 	.interrupt_init = iris_vpu_interrupt_init,
 };
 
+static void iris_vpu33_sm8635_set_preset_registers(struct iris_core *core)
+{
+	/* Stock SM8635 (cliffs) cliffs_reg_preset_table */
+	writel(0x00000000, core->reg_base + 0xb0088);
+	writel(0x33332222, core->reg_base + 0x10830);
+	writel(0x44444444, core->reg_base + 0x10834);
+	writel(0x00001022, core->reg_base + 0x10838);
+	writel(0x00000099, core->reg_base + 0xa013c);
+}
+
+const struct vpu_ops iris_vpu33_sm8635_ops = {
+	.power_off_hw = iris_vpu33_power_off_hardware,
+	.power_on_hw = iris_vpu_power_on_hw,
+	.power_off_controller = iris_vpu33_power_off_controller,
+	.power_on_controller = iris_vpu_power_on_controller,
+	.calc_freq = iris_vpu3x_vpu4x_calculate_frequency,
+	.set_hwmode = iris_vpu_set_hwmode,
+	.set_preset_registers = iris_vpu33_sm8635_set_preset_registers,
+	.interrupt_init = iris_vpu_interrupt_init,
+};
+
 const struct vpu_ops iris_vpu35_ops = {
 	.power_off_hw = iris_vpu35_power_off_hw,
 	.power_on_hw = iris_vpu35_power_on_hw,
diff --git a/drivers/media/platform/qcom/iris/iris_vpu_common.h b/drivers/media/platform/qcom/iris/iris_vpu_common.h
index a62b6184b..b9b85aba4 100644
--- a/drivers/media/platform/qcom/iris/iris_vpu_common.h
+++ b/drivers/media/platform/qcom/iris/iris_vpu_common.h
@@ -11,6 +11,7 @@ struct iris_core;
 extern const struct vpu_ops iris_vpu2_ops;
 extern const struct vpu_ops iris_vpu3_ops;
 extern const struct vpu_ops iris_vpu33_ops;
+extern const struct vpu_ops iris_vpu33_sm8635_ops;
 extern const struct vpu_ops iris_vpu35_ops;
 extern const struct vpu_ops iris_vpu4x_ops;
 extern const struct vpu_ops iris_vpu_ar50lt_ops;
-- 
