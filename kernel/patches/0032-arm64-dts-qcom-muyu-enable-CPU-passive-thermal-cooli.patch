From 3b9a174f1fb647d894827cc4b5e4f93fd6e056af Mon Sep 17 00:00:00 2001
From: yym <183073514+yym108@users.noreply.github.com>
Date: Wed, 25 Nov 2026 12:53:23 +0800
Subject: [PATCH] arm64: dts: qcom: muyu: enable CPU passive thermal cooling
 maps

---
 .../boot/dts/qcom/sm8635-xiaomi-muyu.dts      | 53 +++++++++++++++++--
 1 file changed, 50 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts b/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts
index 262d80ee9..ca2f89a8f 100644
--- a/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts
@@ -257,45 +257,84 @@ smp2p_cdsp_in: slave-kernel {
 
 	thermal-zones {
 		cpu-silver-thermal {
-			polling-delay-passive = <0>;
+			polling-delay-passive = <100>;
 			polling-delay = <0>;
 			thermal-sensors = <&tsens1 1>;
 
 			trips {
+				cpu_silver_alert0: trip-point0 {
+					temperature = <75000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
 				cpu_silver_crit: trip-crit {
 					temperature = <115000>;
 					hysteresis = <1000>;
 					type = "critical";
 				};
 			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpu_silver_alert0>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
 		};
 
 		cpu-gold-thermal {
-			polling-delay-passive = <0>;
+			polling-delay-passive = <100>;
 			polling-delay = <0>;
 			thermal-sensors = <&tsens0 3>;
 
 			trips {
+				cpu_gold_alert0: trip-point0 {
+					temperature = <78000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
 				cpu_gold_crit: trip-crit {
 					temperature = <115000>;
 					hysteresis = <1000>;
 					type = "critical";
 				};
 			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpu_gold_alert0>;
+					cooling-device = <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
 		};
 
 		cpu-prime-thermal {
-			polling-delay-passive = <0>;
+			polling-delay-passive = <100>;
 			polling-delay = <0>;
 			thermal-sensors = <&tsens0 11>;
 
 			trips {
+				cpu_prime_alert0: trip-point0 {
+					temperature = <78000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
 				cpu_prime_crit: trip-crit {
 					temperature = <115000>;
 					hysteresis = <1000>;
 					type = "critical";
 				};
 			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpu_prime_alert0>;
+					cooling-device = <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
 		};
 
 		gpu-thermal {
@@ -591,6 +630,7 @@ cpu0: cpu@0 {
 			enable-method = "psci";
 			capacity-dmips-mhz = <1024>;
 			qcom,freq-domain = <&cpufreq_hw 0>;
+			#cooling-cells = <2>;
 		};
 
 		cpu1: cpu@100 {
@@ -600,6 +640,7 @@ cpu1: cpu@100 {
 			enable-method = "psci";
 			capacity-dmips-mhz = <1024>;
 			qcom,freq-domain = <&cpufreq_hw 0>;
+			#cooling-cells = <2>;
 		};
 
 		cpu2: cpu@200 {
@@ -609,6 +650,7 @@ cpu2: cpu@200 {
 			enable-method = "psci";
 			capacity-dmips-mhz = <1024>;
 			qcom,freq-domain = <&cpufreq_hw 0>;
+			#cooling-cells = <2>;
 		};
 
 		cpu3: cpu@300 {
@@ -618,6 +660,7 @@ cpu3: cpu@300 {
 			enable-method = "psci";
 			capacity-dmips-mhz = <1690>;
 			qcom,freq-domain = <&cpufreq_hw 1>;
+			#cooling-cells = <2>;
 		};
 
 		cpu4: cpu@400 {
@@ -627,6 +670,7 @@ cpu4: cpu@400 {
 			enable-method = "psci";
 			capacity-dmips-mhz = <1690>;
 			qcom,freq-domain = <&cpufreq_hw 1>;
+			#cooling-cells = <2>;
 		};
 
 		cpu5: cpu@500 {
@@ -636,6 +680,7 @@ cpu5: cpu@500 {
 			enable-method = "psci";
 			capacity-dmips-mhz = <1690>;
 			qcom,freq-domain = <&cpufreq_hw 1>;
+			#cooling-cells = <2>;
 		};
 
 		cpu6: cpu@600 {
@@ -645,6 +690,7 @@ cpu6: cpu@600 {
 			enable-method = "psci";
 			capacity-dmips-mhz = <1690>;
 			qcom,freq-domain = <&cpufreq_hw 1>;
+			#cooling-cells = <2>;
 		};
 
 		cpu7: cpu@700 {
@@ -654,6 +700,7 @@ cpu7: cpu@700 {
 			enable-method = "psci";
 			capacity-dmips-mhz = <1843>;
 			qcom,freq-domain = <&cpufreq_hw 2>;
+			#cooling-cells = <2>;
 		};
 
 		cpu-map {
-- 
