+		device_type = "memory";
+		reg = <0x00 0xa1980000 0x00 0x36680000>,
+		      <0x00 0xe34b0000 0x00 0x1c350000>,
+		      <0x08 0xc0000000 0x00 0xc0000000>,
+		      <0x09 0x80000000 0x01 0x80000000>;
