From 3746aa9ee07ee9fb12dfb2eb25ae71ef2789f42e Mon Sep 17 00:00:00 2001
From: yym <183073514+yym108@users.noreply.github.com>
Date: Sun, 22 Nov 2026 18:21:21 +0800
Subject: [PATCH 26/28] Input/HID: muyu: fix DPMS touch/stylus loss via
 drm_panel_follower and WN8030 resume recovery

---
 .../boot/dts/qcom/sm8635-xiaomi-muyu.dts      |   3 +-
 drivers/hid/hid-nanosic-wn8030.c              |  48 ++++++--
 .../input/touchscreen/novatek-nt36532-spi.c   | 114 ++++++++++++++----
 3 files changed, 129 insertions(+), 36 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts b/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts
index 9353ca3d6..d99c23237 100644
--- a/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8635-xiaomi-muyu.dts
@@ -2310,6 +2310,7 @@ touchscreen@0 {
 					lcd-id-gpios = <&tlmm 26 GPIO_ACTIVE_HIGH>;
 					pinctrl-0 = <&ts_int_active &ts_lcd_id>;
 					pinctrl-names = "default";
+					panel = <&panel0>;
 				};
 			};
 		};
@@ -3156,7 +3157,7 @@ mdss_dsi0: dsi@ae94000 {
 				#address-cells = <1>;
 				#size-cells = <0>;
 
-				panel@0 {
+				panel0: panel@0 {
 					compatible = "xiaomi,muyu-nt36532";
 					reg = <0>;
 					pinctrl-0 = <&disp0_reset_n_active>;
diff --git a/drivers/hid/hid-nanosic-wn8030.c b/drivers/hid/hid-nanosic-wn8030.c
index 6deb6222b..c0783d903 100644
--- a/drivers/hid/hid-nanosic-wn8030.c
+++ b/drivers/hid/hid-nanosic-wn8030.c
@@ -516,14 +516,20 @@ static void nanosic_wn8030_handle_vendor(struct nanosic_wn8030 *nanosic, u8 *buf
 	/* WN8012(KB) -> HOST, kb detect/attach state info */
 	if (buf[5] == 0x38 && buf[6] == 0x80 && buf[7] == 0xa2) {
 		mutex_lock(&nanosic->conn_mutex);
-		if (((buf[12] & 0x3) == 0x3) && !nanosic->keyboard_attached) {
-			/* Caps LED state saved between reconnects by WN8030 */
-			nanosic_wn8030_set_caps_led(nanosic, false);
-			nanosic_wn8030_set_touchpad(nanosic, true);
-			nanosic_wn8030_add_keyboard_hid(nanosic);
-			nanosic_wn8030_add_touchpad_hid(nanosic);
-			nanosic->keyboard_attached = true;
-			schedule_delayed_work(&nanosic->wake_worker, msecs_to_jiffies(12000));
+		if ((buf[12] & 0x3) == 0x3) {
+			if (!nanosic->keyboard_attached) {
+				/* Caps LED state saved between reconnects by WN8030 */
+				nanosic_wn8030_set_caps_led(nanosic, false);
+				nanosic_wn8030_set_touchpad(nanosic, true);
+				nanosic_wn8030_add_keyboard_hid(nanosic);
+				nanosic_wn8030_add_touchpad_hid(nanosic);
+				nanosic->keyboard_attached = true;
+			} else {
+				/* Re-enable touchpad if MCU re-announces after resume */
+				nanosic_wn8030_set_touchpad(nanosic, true);
+			}
+			mod_delayed_work(system_wq, &nanosic->wake_worker,
+					 msecs_to_jiffies(12000));
 		} else if (((buf[12] & 0x3) == 0x0) && nanosic->keyboard_attached) {
 			cancel_delayed_work_sync(&nanosic->wake_worker);
 			if (nanosic->hid_keyboard) {
@@ -1075,25 +1081,38 @@ static void nanosic_wn8030_remove(struct i2c_client *client)
 static int nanosic_wn8030_resume(struct device *dev)
 {
 	struct nanosic_wn8030 *nanosic = dev_get_drvdata(dev);
+	int ret;
+
+	if (!nanosic->irq_requested)
+		return 0;
 
 	enable_irq(nanosic->client->irq);
 
 	gpiod_set_value_cansleep(nanosic->sleep_gpio, 0);
-	msleep(25);
+	msleep(50);
 
 	if (nanosic->suspended) {
 		dev_warn(dev, "timeout waiting for chip resume. Reseting chip...\n");
 		gpiod_set_value_cansleep(nanosic->reset_gpio, 1);
 		msleep(10);
 		gpiod_set_value_cansleep(nanosic->reset_gpio, 0);
-		msleep(20);
+		msleep(80);
 		nanosic->suspended = false;
-		if (nanosic->uses_ram_fw)
-			return nanosic_wn8030_load_fw(nanosic);
+		if (nanosic->uses_ram_fw) {
+			ret = nanosic_wn8030_load_fw(nanosic);
+			if (ret)
+				return ret;
+		}
 	}
 
-	/* Wake up keyboard after MCU exits sleep */
+	/* Wake up keyboard and re-enable touchpad/keep-alive after MCU exits sleep */
 	nanosic_wn8030_set_kb_power(nanosic, true);
+	if (nanosic->keyboard_attached) {
+		msleep(20);
+		nanosic_wn8030_set_touchpad(nanosic, true);
+		mod_delayed_work(system_wq, &nanosic->wake_worker,
+				 msecs_to_jiffies(12000));
+	}
 
 	return 0;
 }
@@ -1102,6 +1121,9 @@ static int nanosic_wn8030_suspend(struct device *dev)
 {
 	struct nanosic_wn8030 *nanosic = dev_get_drvdata(dev);
 
+	if (!nanosic->irq_requested)
+		return 0;
+
 	disable_irq(nanosic->client->irq);
 	cancel_delayed_work_sync(&nanosic->wake_worker);
 
diff --git a/drivers/input/touchscreen/novatek-nt36532-spi.c b/drivers/input/touchscreen/novatek-nt36532-spi.c
index 600d04e48..5a2d56481 100644
--- a/drivers/input/touchscreen/novatek-nt36532-spi.c
+++ b/drivers/input/touchscreen/novatek-nt36532-spi.c
@@ -3,6 +3,7 @@
  * Novatek NT36532 SPI Touchscreen driver (Xiaomi Pad 7 Pro / muyu THP mode)
  */
 
+#include <drm/drm_panel.h>
 #include <linux/delay.h>
 #include <linux/firmware.h>
 #include <linux/gpio/consumer.h>
@@ -79,6 +80,7 @@ struct nvt_nt36532_ts {
 	struct input_dev *input;
 	struct input_dev *pen_input;
 	struct gpio_desc *lcd_id_gpio;
+	struct drm_panel_follower panel_follower;
 	struct delayed_work init_work;
 	struct mutex lock;
 	const char *fw_name;
@@ -89,8 +91,11 @@ struct nvt_nt36532_ts {
 	s16 baseline[NVT_NUM_NODES];
 	s16 diff[NVT_NUM_NODES];
 	int base_frames;
+	int fw_retry_cnt;
 	bool base_ready;
+	bool panel_follower_registered;
 	bool irq_requested;
+	bool irq_enabled;
 	bool was_touching;
 	bool pen_active;
 	bool pen_touching;
@@ -764,6 +769,11 @@ static void nvt_init_work(struct work_struct *work)
 	u8 fw_info[24] = { 0 };
 	int ret;
 
+	if (ts->irq_requested && ts->irq_enabled) {
+		disable_irq(spi->irq);
+		ts->irq_enabled = false;
+	}
+
 	mutex_lock(&ts->lock);
 	ts->base_ready = false;
 	ts->base_frames = 0;
@@ -771,10 +781,20 @@ static void nvt_init_work(struct work_struct *work)
 
 	ret = request_firmware(&fw, ts->fw_name, &spi->dev);
 	if (ret) {
-		dev_err(&spi->dev, "request_firmware(%s) failed: %d\n", ts->fw_name, ret);
 		mutex_unlock(&ts->lock);
+		if (!ts->irq_requested && ts->fw_retry_cnt < 10) {
+			ts->fw_retry_cnt++;
+			dev_info(&spi->dev,
+				 "firmware %s not ready (%d), retrying (%d/10)\n",
+				 ts->fw_name, ret, ts->fw_retry_cnt);
+			schedule_delayed_work(&ts->init_work, msecs_to_jiffies(1000));
+		} else {
+			dev_err(&spi->dev, "request_firmware(%s) failed: %d\n",
+				ts->fw_name, ret);
+		}
 		return;
 	}
+	ts->fw_retry_cnt = 0;
 
 	ret = nvt_download_fw(ts, fw);
 	release_firmware(fw);
@@ -805,15 +825,64 @@ static void nvt_init_work(struct work_struct *work)
 						nvt_nt36532_irq_handler,
 						IRQF_TRIGGER_RISING | IRQF_ONESHOT,
 						dev_name(&spi->dev), ts);
-		if (ret)
+		if (ret) {
 			dev_err(&spi->dev, "request_irq(%d) failed: %d\n", spi->irq, ret);
-		else
+		} else {
 			ts->irq_requested = true;
-	} else {
+			ts->irq_enabled = true;
+		}
+	} else if (!ts->irq_enabled) {
 		enable_irq(spi->irq);
+		ts->irq_enabled = true;
+	}
+}
+
+static void nvt_nt36532_do_suspend(struct nvt_nt36532_ts *ts)
+{
+	cancel_delayed_work_sync(&ts->init_work);
+	if (ts->irq_requested && ts->irq_enabled) {
+		disable_irq(ts->spi->irq);
+		ts->irq_enabled = false;
+	}
+
+	mutex_lock(&ts->lock);
+	nvt_release_pen(ts);
+	if (ts->was_touching) {
+		struct input_mt_pos pos[NVT_MAX_TOUCHES];
+		int slots[NVT_MAX_TOUCHES];
+
+		input_mt_assign_slots(ts->input, slots, pos, 0, 0);
+		input_mt_sync_frame(ts->input);
+		input_sync(ts->input);
+		ts->was_touching = false;
 	}
+	mutex_unlock(&ts->lock);
+}
+
+static int nvt_nt36532_panel_prepared(struct drm_panel_follower *follower)
+{
+	struct nvt_nt36532_ts *ts =
+		container_of(follower, struct nvt_nt36532_ts, panel_follower);
+	unsigned long delay = ts->irq_requested ? 200 : 3000;
+
+	mod_delayed_work(system_wq, &ts->init_work, msecs_to_jiffies(delay));
+	return 0;
+}
+
+static int nvt_nt36532_panel_unpreparing(struct drm_panel_follower *follower)
+{
+	struct nvt_nt36532_ts *ts =
+		container_of(follower, struct nvt_nt36532_ts, panel_follower);
+
+	nvt_nt36532_do_suspend(ts);
+	return 0;
 }
 
+static const struct drm_panel_follower_funcs nvt_nt36532_panel_follower_funcs = {
+	.panel_prepared = nvt_nt36532_panel_prepared,
+	.panel_unpreparing = nvt_nt36532_panel_unpreparing,
+};
+
 static int nvt_nt36532_probe(struct spi_device *spi)
 {
 	struct nvt_nt36532_ts *ts;
@@ -915,7 +984,18 @@ static int nvt_nt36532_probe(struct spi_device *spi)
 
 	spi_set_drvdata(spi, ts);
 	INIT_DELAYED_WORK(&ts->init_work, nvt_init_work);
-	schedule_delayed_work(&ts->init_work, msecs_to_jiffies(3000));
+
+	if (drm_is_panel_follower(&spi->dev)) {
+		ts->panel_follower.funcs = &nvt_nt36532_panel_follower_funcs;
+		ret = devm_drm_panel_add_follower(&spi->dev, &ts->panel_follower);
+		if (ret)
+			return dev_err_probe(&spi->dev, ret,
+					     "failed to add drm panel follower\n");
+		ts->panel_follower_registered = true;
+	} else {
+		schedule_delayed_work(&ts->init_work, msecs_to_jiffies(3000));
+	}
+
 	return 0;
 }
 
@@ -981,23 +1061,10 @@ static int nvt_nt36532_suspend(struct device *dev)
 {
 	struct nvt_nt36532_ts *ts = dev_get_drvdata(dev);
 
-	cancel_delayed_work_sync(&ts->init_work);
-	if (ts->irq_requested)
-		disable_irq(ts->spi->irq);
-
-	mutex_lock(&ts->lock);
-	nvt_release_pen(ts);
-	if (ts->was_touching) {
-		struct input_mt_pos pos[NVT_MAX_TOUCHES];
-		int slots[NVT_MAX_TOUCHES];
-
-		input_mt_assign_slots(ts->input, slots, pos, 0, 0);
-		input_mt_sync_frame(ts->input);
-		input_sync(ts->input);
-		ts->was_touching = false;
-	}
-	mutex_unlock(&ts->lock);
+	if (ts->panel_follower_registered)
+		return 0;
 
+	nvt_nt36532_do_suspend(ts);
 	return 0;
 }
 
@@ -1005,7 +1072,10 @@ static int nvt_nt36532_resume(struct device *dev)
 {
 	struct nvt_nt36532_ts *ts = dev_get_drvdata(dev);
 
-	schedule_delayed_work(&ts->init_work, msecs_to_jiffies(300));
+	if (ts->panel_follower_registered)
+		return 0;
+
+	mod_delayed_work(system_wq, &ts->init_work, msecs_to_jiffies(300));
 	return 0;
 }
 
-- 
