From d453c5d3cd468f432cb4de10815e6e47d311bb1e Mon Sep 17 00:00:00 2001
From: yym <183073514+yym108@users.noreply.github.com>
Date: Sat, 21 Nov 2026 11:36:11 +0800
Subject: [PATCH 04/28] drm/msm/dsi: support Dual-DSI 4nm PHY sync, DSC 1.1 RC,
 NT36532 muyu panel and dual KTZ8866

---
 drivers/gpu/drm/msm/dsi/dsi_host.c            |   6 +
 drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c     |   7 +-
 drivers/gpu/drm/panel/panel-novatek-nt36532.c | 224 ++++++++++++++++++
 drivers/video/backlight/ktz8866.c             |   5 +-
 4 files changed, 240 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 78f0fd259..24567d0c0 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -1917,6 +1917,12 @@ static int dsi_populate_dsc_params(struct msm_dsi_host *msm_host, struct drm_dsc
 		return ret;
 	}
 
+	if (dsc->dsc_version_minor == 1 && dsc->bits_per_component == 10 &&
+	    dsc->bits_per_pixel == (8 << 4) && dsc->slice_height >= 8) {
+		dsc->first_line_bpg_offset = 12 + ((9 * min(34, dsc->slice_height - 8)) / 100);
+		dsc->rc_range_params[0].range_max_qp = 8;
+	}
+
 	dsc->initial_scale_value = drm_dsc_initial_scale_value(dsc);
 	dsc->line_buf_depth = dsc->bits_per_component + 1;
 
diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
index ce86dbf61..bb365693b 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
@@ -528,8 +528,12 @@ static int dsi_pll_7nm_vco_prepare(struct clk_hw *hw)
 		dsi_pll_phy_dig_reset(pll_7nm->slave);
 
 	dsi_pll_enable_global_clk(pll_7nm);
-	if (pll_7nm->slave)
+	if (pll_7nm->slave) {
+		u32 clk_cfg0 = readl(pll_7nm->phy->base + REG_DSI_7nm_PHY_CMN_CLK_CFG0);
+
+		dsi_pll_cmn_clk_cfg0_write(pll_7nm->slave, clk_cfg0);
 		dsi_pll_enable_global_clk(pll_7nm->slave);
+	}
 
 	writel(0x1, pll_7nm->phy->base + REG_DSI_7nm_PHY_CMN_RBUF_CTRL);
 	if (pll_7nm->slave)
@@ -1096,6 +1100,7 @@ static int dsi_7nm_phy_enable(struct msm_dsi_phy *phy,
 	data = DSI_7nm_PHY_CMN_CTRL_0_DIGTOP_PWRDN_B |
 	       DSI_7nm_PHY_CMN_CTRL_0_PLL_SHUTDOWNB;
 	writel(data, base + REG_DSI_7nm_PHY_CMN_CTRL_0);
+	writel(0xc0, phy->pll_base + REG_DSI_7nm_PHY_PLL_SYSTEM_MUXES);
 	spin_unlock_irqrestore(&pll->pll_enable_lock, flags);
 
 	/* Assert PLL core reset */
