[Unit]
Description=HexagonRPC FastRPC Daemon for Xiaomi Pad 7 Pro ADSP SensorsPD
After=local-fs.target
Before=iio-sensor-proxy.service

[Service]
ExecStart=/usr/local/bin/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -s -R /usr/share/qcom/sm8635/xiaomi/muyu
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
